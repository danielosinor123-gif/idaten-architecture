b:= rect(40960e-9, 100e-9).transl(0e-9, -30e-9, 0)
setgeom(c50.add(b))
saveas(geom, "YIG1")



defregion(252, yrange(20e-9, inf))  // left half

saveas(geom, "totGeom")

Msat.setregion(252, 800e3)


Aex.setregion(252, 13e-12)
alpha.setregion(252, 0.01)







//m.LoadFile("mStart.ovf")
//saveas(m,"mStartNEW.ovf")

// https://www.sciencedirect.com/science/article/pii/S0304885317306650
nxp := 2.0
mult := 2.0

alstart := 0.0009 //alpha at start of ABL
alstop := 0.08 //alpha at stop of ABL
xstart := 40960-20480-2500 //x at start of ABL in nm
xstop := 40960-20480 //x at stop of ABL in nm
n := 2 //Polynomial order
a := (alstop-alstart)/Pow((xstop-xstart), nxp) //Polynomial coefficient 
cX := 5e-9 //Cellsize along x
NB := ((xstop-xstart)*1e-9)/cX
//No. of cells in ABL
//Set the damping cellwise
for i :=0; i<NB/mult; i++{
    xcurr := xstart*1e-9 + i*cX*mult
    DefRegion(i, (rect(cX*mult, 100e-9).transl(xcurr+(cX*mult)/2.,-30e-9, 0)).add(rect(cX*mult, 100e-9).transl(-xcurr-(cX*mult)/2., -30e-9, 0)))  
    alp := a*Pow(((xcurr*1e9) - xstart), n)+alstart  // KB changed +alstart
    alpha.setregion(i, alp)
    Aex.setregion(i, 3.75e-12)
    Msat.setregion(i, 140.0e3)

}



DefRegion(251, rect(40960e-9-5000e-9+10e-9, 100e-9).transl(0e-9, -30e-9, 0))
alpha.setregion(251, 0.0009)
Aex.setregion(251, 3.75e-12)
Msat.setregion(251, 140.0e3)

ext_scaleExchange(252, 251, S)


m = Uniform(0.01,0.01, 1.0)
Ba := 100.0e-3
B_ext = vector(0.01*Ba, 0.01*Ba, Ba)
minimize()
MaxErr = 0.5e-7
relax()

saveas(m,"m_min100mT.ovf")
saveas(B_ext,"Bext_min100mT.ovf")
saveas(m_full,"m_full_min100mT")



B_ext = vector(0.01*Bn, 0.01*Bn, Bn)
MaxErr = 0.5e-7
minimize()
relax()


saveas(m,"mStart.ovf")
saveas(B_ext,"Bstart.ovf")
saveas(m_full,"Mfull_start")
save(B_eff)


//SetSolver(2) // Heun
//FixDt = 1e-15
//MaxErr = 1e-7
//MaxDt = 1e-12
mx := m.Comp(0)

//mx_center := CropX(mx, 3192, 5192)

mx_center := CropY(mx, 0, 25)
mx_center_line := CropY(mx, 10, 11)

driv := 0.001/25.        // amplitude driving field 
f    := 1.0e9            // frequency units 
fdel := 20.*f*2.*pi   // frequency window 
toff := 3./f              // offset 
time := 12e-9


 //B_ext = vector(0.1E-3+driv*sin( (t-toff)*fdel )/(2*pi*(t-toff)*fdel), 0.1E-3,30e-3) 
B_ext.Add(LoadFile("CPW32_40um.ovf"),driv*sin( (t-toff)*fdel )/((t-toff)*fdel) )

B_ext_Line := Crop(B_ext, 0, 8192, 0, 1, 0, 1)

autosave(B_ext_Line, 10e-12)
autosave(mx_center, 10e-12)
autosave(mx_center_line, 5e-12)
tableautosave(5e-12)
//autosave(B_ext, 75e-12)
run(time)
saveas(m,"Finish.ovf")










