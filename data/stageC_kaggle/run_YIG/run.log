//output directory: deck.out/
//starting GUI at http://127.0.0.1:35367
SetGridSize(2000, 160, 1)
SetCellSize(5e-08, 5e-08, 1.2e-06)
// WARNING: cell size was set to a high aspect ratio.
//          Calculation of demag kernel may take longer than usual.
//          Note that this can exacerbate discretization anisotropy.
OutputFormat = OVF2_TEXT
Msat = 140.0e3
Aex = 5.0e-12
alpha = 2.7e-5
magcount := 64
mags := rect(100e-9, 50e-9).transl(60e-6, 2e-6, 0)
for i := 1; i < magcount; i++ {
	mags = mags.add(rect(100e-9, 50e-9).transl(60e-6+i*200e-9, 2e-6, 0))
}
DefRegion(252, mags)
Msat.setregion(252, 800.0e3)
Aex.setregion(252, 13.0e-12)
alpha.setregion(252, 0.01)
ext_scaleExchange(252, 0, 0.0)
m = Uniform(1, 0, 0)
B_ext = vector(20e-3, 0, 0)
minimize()
//Did not use cached kernel: open /tmp/mumax3kernel_[2000 160 1]_[0 0 0]_[5e-08 5e-08 1.2e-06]_6_0 0.ovf: no such file or directory
// Calculating demag kernel 0 %
// Calculating demag kernel 100 %
//Cached kernel: /tmp/mumax3kernel_[2000 160 1]_[0 0 0]_[5e-08 5e-08 1.2e-06]_6_
relax()
saveas(m, "mStart.ovf")
t0 := t
f0 := 1.70e9
B_ext.Add(LoadFile("antenna.ovf"), 1e-3*sin(2*pi*f0*(t-t0))*(tanh((t-t0-0.5e-9)/0.1e-9)-tanh((t-t0-3e-9)/0.1e-9)))
nprobe := 8
for p := 0; p < nprobe; p++ {
	xc0 := 200 + 200*p
	tableadd(Crop(m.Comp(2), xc0, xc0+80, 0, 80, 0, 1))
}
tableautosave(20e-12)
autosave(m, 500e-12)
run(4e-9)
saveas(m, "Finish.ovf")
