// =====================================================================
// Idaten Ce100 - Stage C: material portfolio shoot-out (bare bus)
// =====================================================================
// Same geometry as Stage B (2000 x 160 x 1 @ 50 nm = 100 um x 8 um bus,
// 64 Ni81Fe19 result elements at a = 200 nm downstream), but the P0
// phase-code landscape is REMOVED: Stage C measures the BARE bus
// propagation per material on the identical structure, the Phase-1.1
// shoot-out of docs/CREDIBILITY_PLAN.md (measured decay length l, group
// velocity v_g, damping behaviour per material).
//
// The bus material block below is substituted by the runner with one of
//   YIG / BiYIG / CoFe / GdFeCoP / NiFe  (see MATERIALS in the runner).
// Parameter values are typical literature values, tagged (L); they are
// inputs, not results.
//
// MEASURED HERE (S, by tools/analyze_stageC.py on the outputs):
//   - probe table: mz averaged over 8 x-probes + global mx,my,mz,
//     every 20 ps  ->  dominant frequency, wave-packet arrival time per
//     probe -> v_g = dx/dt, envelope decay along x -> l
//   - full m snapshots every 500 ps -> spatial envelope(x, t)
//
// The hematite (alpha-Fe2O3) arm needs the AF Neel-vector model of
// mumax+ 1.2.2 and is NOT in this mumax3 run; see PROVENANCE section 2.7.
//
// Drive: identical to Stage B - CPW antenna.ovf, 1.70 GHz burst,
// 1 mT, window t = 0.5..3 ns. Run: 4 ns at 2 ps steps.
// =====================================================================

SetGridSize(2000, 160, 1)
SetCellSize(5e-08, 5e-08, 1.2e-06)
OutputFormat = OVF2_TEXT

// ---------------- bus material: substituted by the runner ---------------
// (placeholder must be on its own line: the runner's first line would be
//  commented out otherwise)
@MATERIAL_BLOCK@

// ---------------- M_k: the result elements (identical to Stage B) --------
magcount := 64
mags := rect(100e-9, 50e-9).transl(60e-6, 2e-6, 0)
for i := 1; i < magcount; i++ {
    mags = mags.add(rect(100e-9, 50e-9).transl(60e-6 + i*200e-9, 2e-6, 0))
}
DefRegion(252, mags)
Msat.setregion(252, 800.0e3)
Aex.setregion(252, 13.0e-12)
alpha.setregion(252, 0.01)
ext_scaleExchange(252, 0, 0.0)

// ---------------- initial state, bias -------------------------------------
m = Uniform(1, 0, 0)
B_ext = vector(20e-3, 0, 0)
minimize()
relax()
saveas(m, "mStart.ovf")
t0 := t   // relax() may advance engine time (region-dependent); anchor the
          // drive window to post-relax t so the burst always fires

// ---------------- drive: burst from the CPW edge antenna -------------------
f0 := 1.70e9
B_ext.Add(LoadFile("antenna.ovf"), 1e-3 * sin(2*pi*f0*(t-t0)) *
    (tanh((t-t0-0.5e-9)/0.1e-9) - tanh((t-t0-3e-9)/0.1e-9)))

// ---------------- measurement table ---------------------------------------
// Default table columns t, mx, my, mz (spatial averages) are automatic.
// Probe p = average of mz over x cells [200+200p, 280+200p), y [0,80)
// (x = 10+10p um, y = 0..4 um); Crop() takes CELL indices and the table
// stores the crop's spatial average (verified on mumax3 3.12).
nprobe := 8
for p := 0; p < nprobe; p++ {
    xc0 := 200 + 200*p
    tableadd(Crop(m.Comp(2), xc0, xc0+80, 0, 80, 0, 1))
}
tableautosave(20e-12)
autosave(m, 500e-12)

// ---------------- run ------------------------------------------------------
run(4e-9)
saveas(m, "Finish.ovf")
